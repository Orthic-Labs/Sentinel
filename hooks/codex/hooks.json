{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "FORGE_HOST=codex node \"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/dispatcher.js\"" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "FORGE_HOST=codex node \"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/dispatcher.js\"" }] }],
    "PreToolUse": [{ "matcher": "shell|shell_command|Bash|PowerShell|Write|Edit|MultiEdit|apply_patch", "hooks": [{ "type": "command", "command": "FORGE_HOST=codex node \"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/dispatcher.js\"", "timeout": 10 }] }],
    "PostToolUse": [{ "matcher": "shell|shell_command|Bash|PowerShell", "hooks": [{ "type": "command", "command": "FORGE_HOST=codex node \"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/dispatcher.js\"", "timeout": 10 }] }],
    "PostToolUseFailure": [{ "matcher": "shell|shell_command|Bash|PowerShell|Write|Edit|MultiEdit|apply_patch", "hooks": [{ "type": "command", "command": "FORGE_HOST=codex node \"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/dispatcher.js\"", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "FORGE_HOST=codex node \"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/dispatcher.js\"", "timeout": 10 }] }]
  }
}
