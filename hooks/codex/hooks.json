{
  "hooks": {
    "PreToolUse": [{
      "matcher": "shell|shell_command|Bash|PowerShell|Write|Edit|MultiEdit|apply_patch",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/codex/hook.js\"",
        "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\codex\\hook.js\"",
        "timeout": 10,
        "statusMessage": "Checking Tether risk gate..."
      }]
    }],
    "PostToolUse": [{
      "matcher": "shell|shell_command|Bash|PowerShell",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/codex/hook.js\"",
        "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\codex\\hook.js\"",
        "timeout": 10,
        "statusMessage": "Recording Tether verification..."
      }]
    }],
    "PostToolUseFailure": [{
      "matcher": "shell|shell_command|Bash|PowerShell|Write|Edit|MultiEdit|apply_patch",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/codex/hook.js\"",
        "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\codex\\hook.js\"",
        "timeout": 10,
        "statusMessage": "Recording Tether failure..."
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/codex/hook.js\"",
        "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\codex\\hook.js\"",
        "timeout": 10,
        "statusMessage": "Checking Tether signoff..."
      }]
    }]
  }
}
